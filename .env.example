# ============================================================
# finance-tracker — Zugangsdaten für die HBCI/FinTS-Verbindung
# ============================================================
# 1. Kopiere diese Datei:       cp .env.example .env
# 2. Trage deine echten Werte in .env ein
# 3. .env ist in der .gitignore — NIEMALS committen!
#
# Die Scripte transaktionen_speichern.py, db_anzeigen.py, manuelle_ueberprüfung.py
# und testverbindung.py laden diese Werte automatisch (über python-dotenv).

# ------------------------------------------------------------
# Auswahl der Bank (muss einem der Präfixe unten entsprechen)
# ------------------------------------------------------------
BANK=comdirect

# ------------------------------------------------------------
# SQLite-Datenbank für die Umsatzdaten
# ------------------------------------------------------------
# Pfad zur SQLite-Datei, in die transaktionen_speichern.py die
# Umsätze schreibt und die db_anzeigen.py ausliest.
# Relativ zum Projektordner oder als absoluter Pfad.
DB_PATH=finance.db

# ------------------------------------------------------------
# comdirect (BLZ 20041133, FinTS-Endpunkt fints.comdirect.de)
# username = Kontonummer (nur Zahlen) + Unterkonto (0 für das erste)
# PIN = wird NICHT hier gespeichert, sondern beim Start des Scripts
#       sicher (ohne Echo) per getpass abgefragt!
# tan_mechanism = gewünschtes TAN-Verfahren, z.B. 'M1Q' (photoTAN-QR)
# ------------------------------------------------------------
COMDIRECT_BLZ=20041133
COMDIRECT_USERNAME=12345678900
COMDIRECT_HBCI=https://fints.comdirect.de/fints
COMDIRECT_TAN_MECHANISM=902

# ------------------------------------------------------------
# DKB (Deutsche Kreditbank, BLZ 12030000)
# username = DKB-LogIn (Kontonummer o.ä.)
# PIN = wird NICHT hier gespeichert, sondern beim Start des Scripts
#       sicher (ohne Echo) per getpass abgefragt!
# tan_mechanism = gewünschtes TAN-Verfahren, z.B. 'M1P' (photoTAN)
# ------------------------------------------------------------
DKB_BLZ=12030000
DKB_USERNAME=DKBLogIn
DKB_HBCI=https://fints.dkb.de/fints
DKB_TAN_MECHANISM=940
